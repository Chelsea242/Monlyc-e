<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_student_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Ligne supérieure: Avatar + Nom/Prénom + Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar circulaire avec initiales -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:id="@+id/tv_avatar_initials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp"
                    tools:text="MJ" />
            </FrameLayout>

            <!-- Nom, Prénom et Matricule -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    tools:text="MOUKASSA Jean-Pierre" />

                <TextView
                    android:id="@+id/tv_student_matricule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    tools:text="Matricule: LYC-2026-0042" />
            </LinearLayout>

            <!-- Actions Rapides: Appel & Menu -->
            <ImageButton
                android:id="@+id/btn_quick_call"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_call"
                android:src="@drawable/ic_call"
                app:tint="@color/colorSecondary" />

            <ImageButton
                android:id="@+id/btn_quick_delete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/danger_color" />
        </LinearLayout>

        <!-- Ligne des Badges (Niveau, Série, Sexe, Classe) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Badge Niveau -->
            <TextView
                android:id="@+id/tv_badge_niveau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_level"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_level_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Terminale" />

            <!-- Badge Série -->
            <TextView
                android:id="@+id/tv_badge_serie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_serie"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_serie_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Série D" />

            <!-- Badge Classe -->
            <TextView
                android:id="@+id/tv_badge_classe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_gender"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_gender_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Tle D 1" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Badge Sexe -->
            <TextView
                android:id="@+id/tv_badge_sexe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="♂ Masculin" />
        </LinearLayout>

        <!-- Séparateur fin -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/divider_color" />

        <!-- Infos complémentaires (Ville/Quartier, Téléphone) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_student_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Brazzaville, Bacongo" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_call"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_student_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="+242 06 123 45 67" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
