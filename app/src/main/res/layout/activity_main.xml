<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background">

    <!-- Barre supérieure de l'application (Header Premium) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_color"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_mylycee_logo_1790244114254" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Inscriptions &amp; Gestion Scolaire"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Bouton Inscription Rapide dans l'en-tête -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_header_add"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="12dp"
                android:text="+ Élève"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_user_add"
                app:iconSize="16dp"
                app:iconTint="@color/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Conteneur principal pour les différentes vues/écrans -->
    <FrameLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation_bar"
        app:layout_constraintTop_toBottomOf="@+id/top_toolbar" />

    <!-- Barre de Navigation Inférieure avec Animations au Clic -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Onglet 1: Tableau de bord -->
        <LinearLayout
            android:id="@+id/nav_item_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_icon_dashboard"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_dashboard"
                android:src="@drawable/ic_dashboard"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/nav_label_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/nav_dashboard"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Onglet 2: Liste des Inscrits -->
        <FrameLayout
            android:id="@+id/nav_item_students"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_students"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_students"
                    android:src="@drawable/ic_students_list"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/nav_label_students"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nav_students"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Pastille / Badge du nombre d'inscrits -->
            <TextView
                android:id="@+id/nav_badge_students"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_stat_card_blue"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingHorizontal="4dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="4"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Onglet 3: Nouvelle Inscription -->
        <LinearLayout
            android:id="@+id/nav_item_register"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_icon_register"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_register"
                android:src="@drawable/ic_user_add"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/nav_label_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Inscription"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Onglet 4: Paramètres -->
        <LinearLayout
            android:id="@+id/nav_item_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_icon_settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/nav_label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_settings"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
